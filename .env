# AIConnex Environment Configuration
# Place your Google Gemini API key below to enable LLM code patching in ScoutAgent

GEMINI_API_KEY=AQ.Ab8RN6KPtOg9ejuXi9uG9spWXyxR4vJdxtc0UoW-DLhWrEyrWA

OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_BASE_URL=http://localhost:11434

# AICONNEX_LLM_BACKEND selects the agent's LLM provider: "openrouter" (primary),
# "ollama" (offline fallback), or "openai".
AICONNEX_LLM_BACKEND=openrouter
OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct

# OpenRouter Configuration (Qwen SOTA Models)
OPENROUTER_API_KEY=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
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# MLflow Telemetry Configuration
MLFLOW_TRACKING_URI=sqlite:///x:/TAS/AICONNEX/mlflow.db
MLFLOW_ALLOW_FILE_STORE=true

# LangSmith Tracing Configuration
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=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
LANGSMITH_PROJECT=aiconnex

# LangGraph Checkpoint Serialization — allow AIConnex Pydantic schema types
# to be deserialized from SqliteSaver checkpoints without security warnings.
# Without this, every resume after the first turn logs noisy WARNING messages.
LANGGRAPH_ALLOWED_MSGPACK_MODULES=aiconnex_agent.schemas

# ─── Platform Knowledge Base Configuration ──────────────────────────────────
KB_STRICT_PRODUCTION_MODE=true

# PostgreSQL Config (Relational & Hybrid Catalog)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=aiconnex_kb_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Qdrant Vector DB Config (Semantic Search Engine)
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=platform_kb_embeddings
QDRANT_VECTOR_DIM=384

# MinIO Object Storage Config (Original Document Storage)
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_secret_password_2026
MINIO_BUCKET=aiconnex-platform-kb-prod
MINIO_SECURE=false

