# AIConnex Environment Configuration
# Place your Google Gemini API key below to enable LLM code patching in ScoutAgent

GEMINI_API_KEY=AQ.Ab8RN6KPtOg9ejuXi9uG9spWXyxR4vJdxtc0UoW-DLhWrEyrWA

OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_BASE_URL=http://localhost:11434

# AICONNEX_LLM_BACKEND selects the agent's LLM provider: "ollama" (default)
# or "openai". Ollama stays selected for now, using the Ollama Cloud model
# above (quality over local latency - requires `ollama signin`).
# To switch to OpenAI later: set AICONNEX_LLM_BACKEND=openai and add
# OPENAI_API_KEY below.
AICONNEX_LLM_BACKEND=ollama
# OPENAI_API_KEY=
