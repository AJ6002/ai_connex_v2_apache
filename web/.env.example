# Base URL for the AI-ConneX FastAPI application layer (Phase 2 Intake & Capability Services).
# Every REST network call in the app resolves its host from this single value via api/client.ts.
VITE_API_BASE=http://localhost:8000

# Server-Sent Events (SSE) / WebSocket stream URL for live Job telemetry and agent logs.
VITE_STREAM_BASE=http://localhost:8000

# Default Tenant UID context for multi-tenant requests (overridden when OIDC is active).
VITE_DEFAULT_TENANT_UID=tenant-001

# When "true", the app starts the MSW mock service worker and serves all
# capability endpoints from local fixtures instead of a real backend.
VITE_USE_MOCKS=true
