# AIConnex Environment Configuration Template
# Copy this file to .env and configure your keys

# LLM Providers (Google Gemini / OpenRouter / Ollama)
GEMINI_API_KEY=your_gemini_api_key_here
AICONNEX_LLM_BACKEND=openrouter
OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Offline LLM Fallback (Ollama)
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_BASE_URL=http://localhost:11434

# MLflow Telemetry Configuration
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_ALLOW_FILE_STORE=true

# LangSmith Tracing (Optional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aiconnex

# LangGraph Serialization
LANGGRAPH_ALLOWED_MSGPACK_MODULES=aiconnex_agent.schemas

# ─── Platform Knowledge Base Configuration (Docker Services) ────────────────
KB_STRICT_PRODUCTION_MODE=true

# PostgreSQL Config (Docker pgvector)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=aiconnex_kb_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Qdrant Vector DB Config (Docker Qdrant)
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=platform_kb_embeddings
QDRANT_VECTOR_DIM=384

# MinIO Object Storage Config (Docker MinIO)
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_secret_password_2026
MINIO_BUCKET=aiconnex-platform-kb-prod
MINIO_SECURE=false
